+        check(!spokenMap[@0] && spokenMap[@1], @"missing pronunciation does not borrow neighbour");
+        NSString *lang = @"{\"content\":[{\"type\":0,\"lyricContent\":[[\"ka\",\"ze\"]]}]}";
