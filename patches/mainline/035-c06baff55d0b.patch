From c06baff55d0b8599228059d78dc3177210017eeb Mon Sep 17 00:00:00 2001
From: ddyec <89333385+ddyec@users.noreply.github.com>
Date: Wed, 21 Oct 2026 04:13:44 +0000
Subject: [PATCH] build: avoid repeating unsupported alternate icon compilation

---
 docs/performance-followup-20261021.md | 10 ++++++++++
 scripts/app-icon-cache.py             | 11 +++++++++++
 scripts/app-icons.sh                  | 10 ++++++++--
 3 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/docs/performance-followup-20261021.md b/docs/performance-followup-20261021.md
index ae6d7c39ba874fcb5b72b9ebce598bb96407519a..b3c70b8865f59e6dcd2452d8b782b7283e87a832 100644
--- a/docs/performance-followup-20261021.md
+++ b/docs/performance-followup-20261021.md
@@ -44,3 +44,13 @@ at least one minute each of timed playback, pause after animations settle, and b
 export before leaving the session. Playback-state fields and callback-count differences show
 which clock was active; stack records identify any captured loading stalls. Save a fresh
 baseline only in a stable matching scenario. Actual heat and CPU reduction need those runs.
+
+## Packaging results
+
+Runtime build db9c0cb completed in 7m23s (workflow 39542029484), including 325 seconds
+in the combined packaging pipeline. EV1 and generated flags were reused. Compilation,
+Foundation regressions and combined IPA validation passed. Alternate icon generation still
+failed the existing CoreUI catalog validation (159 seconds); the shipped IPA therefore keeps
+the original icon. The build-only follow-up caches this unsupported outcome for the exact
+source assets, templates and Xcode, so later runs can avoid the repeated failed work. An
+asset/template/tool change invalidates it and retries; successful output is also cached.
diff --git a/scripts/app-icon-cache.py b/scripts/app-icon-cache.py
index d274765798a7b40dd2b080f14ab4012d2cce5b0e..136b05ffa8e30c1ee9ae7431aca7343bec0cc162 100644
--- a/scripts/app-icon-cache.py
+++ b/scripts/app-icon-cache.py
@@ -33,6 +33,9 @@ if mode == 'restore':
         sys.exit(1)
     if hashes(cache) != json.loads((cache / 'checksums.json').read_text()):
         raise ValueError('Icon cache checksum mismatch')
+    if (cache / 'unavailable.txt').is_file():
+        print('Alternate icons unavailable for these exact assets/tools: ' + (cache / 'unavailable.txt').read_text())
+        sys.exit(3)
     subprocess.run(['xcrun', 'assetutil', '-Z', str(cache / 'Assets.car')], check=True, stdout=subprocess.DEVNULL)
     current = plistlib.loads(info.read_bytes())
     alternates = plistlib.loads((cache / 'alternates.plist').read_bytes())
@@ -42,6 +45,14 @@ if mode == 'restore':
     shutil.copyfile(cache / 'Assets.car', car)
     shutil.copytree(cache / 'SGAppIconPreviews', folder / 'SGAppIconPreviews', dirs_exist_ok=True)
     print('Reused alternate icons for the same source assets, artwork and Xcode')
+elif mode == 'unavailable':
+    # Remember a deterministic catalog-validation failure for this exact source/tool key.
+    # Do not repeatedly spend minutes compiling output that cannot be injected.
+    if cache.exists():
+        shutil.rmtree(cache)
+    cache.mkdir(parents=True)
+    (cache / 'unavailable.txt').write_text(sys.argv[4])
+    (cache / 'checksums.json').write_text(json.dumps(hashes(cache), sort_keys=True))
 elif mode == 'save':
     cache.mkdir(parents=True, exist_ok=True)
     shutil.copyfile(car, cache / 'Assets.car')
diff --git a/scripts/app-icons.sh b/scripts/app-icons.sh
index dc73664a1b044ad1f94056e9aea9d5bd8218d729..4faa186b59fc4b0e508d5c6b2096e5138378d31c 100755
--- a/scripts/app-icons.sh
+++ b/scripts/app-icons.sh
@@ -29,7 +29,10 @@ unzip -q "$OUT" "${APP_DIR}Assets.car" "${APP_DIR}Info.plist" -d "$WORK"
 CAR="$WORK/${APP_DIR}Assets.car"
 PLIST="$WORK/${APP_DIR}Info.plist"
 
-if python3 "$ROOT/scripts/app-icon-cache.py" restore "$WORK" "$APP_DIR"; then
+CACHE_STATUS=0
+python3 "$ROOT/scripts/app-icon-cache.py" restore "$WORK" "$APP_DIR" || CACHE_STATUS=$?
+[ "$CACHE_STATUS" != 3 ] || skip "previous catalog validation failed for the same assets and Xcode"
+if [ "$CACHE_STATUS" = 0 ]; then
   (cd "$WORK" && zip -q "$OUT_ABS" "${APP_DIR}Assets.car" "${APP_DIR}Info.plist" "${APP_DIR}SGAppIconPreviews/"*.png)
   exit 0
 fi
@@ -76,7 +79,10 @@ for SUFFIX in "" 2 3 4 5 6 7 8; do
 done
 [ "$MERGED" = 1 ] || skip "every name collided with one of Spotify's"
 xcrun assetutil -U "$WORK/merged.car" -o "$WORK/indexed.car" >/dev/null
-xcrun assetutil -Z "$WORK/indexed.car" >/dev/null || skip "the merged catalog did not validate"
+if ! xcrun assetutil -Z "$WORK/indexed.car" >/dev/null; then
+  python3 "$ROOT/scripts/app-icon-cache.py" unavailable "$WORK" "$APP_DIR" "merged catalog validation failed"
+  skip "the merged catalog did not validate"
+fi
 mv "$WORK/indexed.car" "$CAR"
 
 python3 - "$PLIST" "$SUFFIX" "${NAMES[@]}" <<'EOF'
-- 
2.34.1

