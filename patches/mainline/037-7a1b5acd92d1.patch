diff --git a/docs/performance-followup-20261021.md b/docs/performance-followup-20261021.md
index f03eeafb31ed3c56d8c76044d1770d8339996b29..d8aa31c74787dd92a26a8cae367e40132c5c8b14 100644
--- a/docs/performance-followup-20261021.md
+++ b/docs/performance-followup-20261021.md
@@ -66,3 +66,20 @@ Regression checks reconstruct the rendered bounds for left/center/right anchors
 and paused widths, and verify that mixed single/multi-line groups cannot intersect throughout
 the upward transition. A mutation using the previous center assumption fails these checks.
 Visual acceptance remains on the owner’s device; no simulator or recording is used.
+
+## Play/pause typography continuity
+
+The subsequent device check confirmed alignment but exposed clipping during artwork shrink
+and a delayed rewrap after the follower window. The preview now measures in the unscaled
+artwork coordinates with its stable per-song height budget. The same word/translation views,
+font and wrap inputs survive play/pause. A separate canvas follows the artwork presentation
+scale and position on every animation frame, including rapid reversals. The endpoint hook no
+longer rebuilds text. Normal playback keeps full-size typography; pausing smoothly scales the
+same paragraph with the artwork instead of swapping layouts.
+
+Sentence changes still move upward on the child views. Their motion composes with the parent
+canvas scale, so one transform cannot overwrite the other. Very long groups retain their
+translation and the existing vertical scroll rather than silently dropping content. Real host
+resizing and source/translation changes still update the layout. Regression checks sweep
+shrink/grow reversals and concurrent sentence progress, verifying stable measurement, continuous
+scale and no horizontal truncation or intersecting groups. Visual acceptance remains on-device.
diff --git a/scripts/test-lyrics-identity.py b/scripts/test-lyrics-identity.py
index e3156282a8c0f283c7b0b0c055a0f53eb8f697b3..28b4ecf8a4e2d79d0bf62a65cba65b9251b151a7 100644
--- a/scripts/test-lyrics-identity.py
+++ b/scripts/test-lyrics-identity.py
@@ -116,6 +116,47 @@ int main(void) {
                 }
             }
         }
+        // Keep a single word layout while its canvas scales on every presentation frame.
+        CGSize stableText = sgrPreviewTextSize(cover, player, 88);
+        check(stableText.width == 354 && stableText.height == 88, @"full-size typography and translation budget are stable");
+        CGFloat previousScale = 1;
+        for (NSUInteger cycle = 0; cycle < 4; cycle++) {
+            for (NSUInteger frame = 0; frame <= 120; frame++) {
+                CGFloat progress = frame / 120.0;
+                CGFloat artworkScale = cycle % 2 ? 0.84 + 0.16 * progress : 1 - 0.16 * progress;
+                CGRect shownCover = CGRectInset(cover, cover.size.width * (1 - artworkScale) / 2,
+                    cover.size.height * (1 - artworkScale) / 2);
+                CGRect movingGap = sgrPreviewFrame(shownCover, info, player);
+                CGFloat textScale = sgrPreviewTextScale(movingGap.size.width, stableText.width);
+                check(CGSizeEqualToSize(sgrPreviewTextSize(cover, player, 88), stableText),
+                    @"reversing playback scale never changes font/wrap inputs");
+                check(fabs(textScale - artworkScale) < 0.001 && fabs(textScale - previousScale) < 0.002,
+                    @"glyph scale follows every frame, including reversals, without endpoint substitution");
+                previousScale = textScale;
+                CGSize canvasViewport = CGSizeMake(stableText.width, movingGap.size.height / textScale);
+                for (NSNumber *edge in @[@0, @0.5, @1]) {
+                    CGPoint anchor = CGPointMake(edge.doubleValue, 0.5);
+                    CGPoint position = sgrPreviewLinePosition(canvasViewport, stableText, anchor);
+                    CGFloat left = (position.x - anchor.x * stableText.width) * textScale;
+                    check(left >= -0.001 && left + stableText.width * textScale <= movingGap.size.width + 0.001,
+                        @"scaled word groups remain horizontally unclipped for every anchor");
+                }
+                CGFloat travel = sgrPreviewRollDistance(canvasViewport.height, 56, 84);
+                for (NSUInteger step = 0; step <= 10; step++) {
+                    CGFloat roll = step / 10.0;
+                    CGFloat oldTop = MAX(0, (canvasViewport.height - 56) / 2);
+                    CGFloat newTop = MAX(0, (canvasViewport.height - 84) / 2);
+                    CGFloat oldBottom = (oldTop + 56 - travel * roll) * textScale;
+                    CGFloat nextTop = (newTop + travel * (1 - roll)) * textScale;
+                    check(nextTop - oldBottom >= 8 * textScale - 0.001,
+                        @"vertical sentence movement stays separated while its parent scales");
+                }
+            }
+        }
+        CGRect widerPlayer = CGRectMake(0, 0, 490, 874);
+        check(sgrPreviewTextSize(CGRectMake(24, 118, 442, 442), widerPlayer, 88).width > stableText.width,
+            @"real host resizing still updates text layout");
+        check(CGSizeEqualToSize(sgrPreviewTextSize(CGRectNull, player, 88), CGSizeZero), @"missing artwork cannot yield an invalid text width");
         check(sgrPreviewShouldRoll(YES, 2, 3, 250, NO), @"sequential lyric change rolls upward");
         check(!sgrPreviewShouldRoll(YES, 3, 2, 250, NO) && !sgrPreviewShouldRoll(YES, 2, 5, 250, NO), @"seeks do not replay intermediate lines");
         check(!sgrPreviewShouldRoll(NO, 2, 3, 250, NO) && !sgrPreviewShouldRoll(YES, 2, 3, 250, YES), @"track change and reduced motion do not animate");
