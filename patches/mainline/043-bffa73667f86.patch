From bffa73667f86bca888bbe85295503501a4504f7b Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 23 Oct 2026 12:06:08 +0000
Subject: [PATCH] test: parenthesize Objective-C format calls in localization
 assertions

---
 scripts/test-localization.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/test-localization.py b/scripts/test-localization.py
index c686586ad94611c8cfe6aa06100311e3cb01555b..194034fe690d74c4a594c0973bfd8d3e1fd5c291 100644
--- a/scripts/test-localization.py
+++ b/scripts/test-localization.py
@@ -31,9 +31,9 @@ int main(void) {
             assert([SGTextForLanguage(raw, @"zh") isEqualToString:raw]);
         }
         NSString *format = SGTextForLanguage(@"Downloading %lld %% · %lld of %@", @"zh");
-        assert([[NSString stringWithFormat:format, 50ll, 235ll, @"470 MB"] isEqualToString:@"正在下载 50 % · 235 / 470 MB"]);
+        assert(([[NSString stringWithFormat:format, 50ll, 235ll, @"470 MB"] isEqualToString:@"正在下载 50 % · 235 / 470 MB"]));
         format = SGTextForLanguage(@"Spotify %@ isn't supported", @"zh");
-        assert([[NSString stringWithFormat:format, @"9.1.90"] isEqualToString:@"不支持 Spotify 9.1.90"]);
+        assert(([[NSString stringWithFormat:format, @"9.1.90"] isEqualToString:@"不支持 Spotify 9.1.90"]));
         puts("PASS: Chinese locale selection, English fallback, raw identifiers and formatted UI text");
     }
 }
