From d2e5d6eb98979bfffc9ae36eaaa240ad6b6364fa Mon Sep 17 00:00:00 2001
From: ddyec <89333385+ddyec@users.noreply.github.com>
Date: Wed, 21 Oct 2026 02:33:21 +0000
Subject: [PATCH] test: record lyric reversals in the iOS simulator

---
 .github/workflows/performance-checks.yml | 24 ++++++++++++++++++++++--
 docs/performance-review-2026-10-21.md    |  3 ++-
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/performance-checks.yml b/.github/workflows/performance-checks.yml
index 4f49e14d7cedfb2362b246397555d17655b1be3b..2115d42181c45200a0d13caef19ccb4c4766d798 100644
--- a/.github/workflows/performance-checks.yml
+++ b/.github/workflows/performance-checks.yml
@@ -50,8 +50,28 @@ jobs:
         env:
           HARNESS_ARCH: x86_64
         run: sh harness/player/build.sh
+      - name: Record and check rapid lyric reversals
+        run: |
+          mkdir -p out/motion
+          DEVICE="$(xcrun simctl list devices available -j | python3 -c 'import json,sys; d=json.load(sys.stdin); print(next(x["udid"] for group in d["devices"].values() for x in group if x["name"].startswith("iPhone")))')"
+          xcrun simctl boot "$DEVICE"
+          xcrun simctl bootstatus "$DEVICE" -b
+          xcrun simctl install "$DEVICE" harness/player/build/PlayerHarness.app
+          xcrun simctl io "$DEVICE" recordVideo --codec=h264 out/motion/lyrics-interruptions.mp4 > out/motion/recording.log 2>&1 &
+          RECORD_PID=$!
+          SIMCTL_CHILD_HARNESS_SCENARIO=lyrics-interruptions SIMCTL_CHILD_HARNESS_BACKGROUND=0 \
+            xcrun simctl launch --console "$DEVICE" com.vojta.playerharness > out/motion/player.log 2>&1 &
+          sleep 11
+          xcrun simctl io "$DEVICE" screenshot out/motion/lyrics-final.png
+          kill -INT "$RECORD_PID"
+          wait "$RECORD_PID"
+          xcrun simctl terminate "$DEVICE" com.vojta.playerharness
+          grep -F 'lyrics interruption checks: 4 of 4 right -- PASS' out/motion/player.log
       - uses: actions/upload-artifact@v5
+        if: always()
         with:
           name: performance-source-build
-          path: tweak/packages/*.deb
-          if-no-files-found: error
+          path: |
+            tweak/packages/*.deb
+            out/motion/
+          if-no-files-found: warn
diff --git a/docs/performance-review-2026-10-21.md b/docs/performance-review-2026-10-21.md
index 6aa57615c3bc7257802699bfb8f053149cfa9e89..22219eb3c8c2b4e4caf2ab22b5d5d87059c13642 100644
--- a/docs/performance-review-2026-10-21.md
+++ b/docs/performance-review-2026-10-21.md
@@ -83,7 +83,8 @@ claimed without before/after measurements.
 - `scripts/check-layers.sh`: architecture boundaries.
 - The macOS workflow runs existing lyric regressions, compiles the full tweak
   using flags from the SHA-256 verified clean 9.1.78 IPA, and compiles the player
-  harness. The downloaded IPA is not modified or redistributed.
+  harness, runs its interruption scenario in the simulator and uploads a recording
+  and log. The downloaded IPA is not modified or redistributed.
 - On iOS 26+ in Redesigned UI, inspect preview lines, full lyric open/close,
   rapid reversal, pause/resume, track changes and Reduced Motion. Check Native
   UI diagnostics separately. Record before/after runs in matching scenarios.
-- 
2.34.1

