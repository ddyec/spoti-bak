diff --git a/docs/lyrics-matching.md b/docs/lyrics-matching.md
index 21aff75d506f2d8ad5de2a9bd5bace208559b9f1..dae707486e644e6a443ce337e558a4fe7fd80f0d 100644
--- a/docs/lyrics-matching.md
