 %end
 
 %ctor {
     if (!SGNativeUI()) return;
     %init;
-    SGRequireClasses(@[@"_TtC22Lyrics_NPVContainerKit19LyricsContainerView"]);
+    SGRequireClasses(@[@"_TtC19NowPlaying_ViewImpl24NowPlayingViewController",
