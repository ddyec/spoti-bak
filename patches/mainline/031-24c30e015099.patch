diff --git a/scripts/companion-macho.py b/scripts/companion-macho.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9d1e8483d18d6b2531e36ce116e8a0a8a950165
--- /dev/null
+++ b/scripts/companion-macho.py
@@ -0,0 +1,71 @@
+"""Thin arm64 Mach-O parsing and strong initializer dependency insertion."""
+import struct
+
+DYLIBS = {0xC, 0x80000018, 0x8000001F, 0x80000023}
+
+
+def macho(data):
+    if len(data) < 32 or struct.unpack_from('<I', data)[0] != 0xFEEDFACF:
+        raise ValueError('Expected a thin 64-bit Mach-O')
+    count, size = struct.unpack_from('<II', data, 16)
+    end = 32 + size
+    if end > len(data):
+        raise ValueError('Truncated load commands')
+    off, libs, sections = 32, [], []
+    for _ in range(count):
+        cmd, length = struct.unpack_from('<II', data, off)
+        if length < 8 or off + length > end:
+            raise ValueError('Invalid load command')
+        if cmd in DYLIBS:
+            nameoff = struct.unpack_from('<I', data, off + 8)[0]
+            if not 8 <= nameoff < length:
+                raise ValueError('Invalid dylib name offset')
+            name = data[off + nameoff:off + length].split(b'\0')[0].decode()
+            libs.append((cmd, name))
+        if cmd == 0x19:
+            nsects = struct.unpack_from('<I', data, off + 64)[0]
+            if 72 + 80 * nsects > length:
+                raise ValueError('Truncated segment sections')
+            for i in range(nsects):
+                pos = off + 72 + i * 80
+                name = data[pos:pos + 16].split(b'\0')[0].decode()
+                segment = data[pos + 16:pos + 32].split(b'\0')[0].decode()
+                nbytes, offset = struct.unpack_from('<QI', data, pos + 40)
+                flags = struct.unpack_from('<I', data, pos + 64)[0]
+                # Zero-fill sections have no on-disk contents.
+                if offset and (flags & 0xFF) not in (1, 0xC, 0x12):
+                    if offset + nbytes > len(data):
+                        raise ValueError('Truncated section contents')
+                    sections.append((offset, nbytes, segment, name))
+        off += length
+    if off != end:
+        raise ValueError('Load-command count/size mismatch')
+    return count, size, libs, sections
+
+
+def add_dependency(data, dependency):
+    count, size, libs, sections = macho(data)
+    if not any(segment == '__TEXT' and name == '__text' for _, _, segment, name in sections):
+        raise ValueError('No executable text section')
+    existing = [cmd for cmd, name in libs if name == dependency]
+    if existing:
+        if 0xC not in existing:
+            raise ValueError('EEVEE dependency must be a strong LC_LOAD_DYLIB')
+        return data
+    name = dependency.encode() + b'\0'
+    length = (24 + len(name) + 7) & ~7
+    start = 32 + size
+    first = min((offset for offset, _, _, _ in sections), default=len(data))
+    if start + length > first or any(data[start:start + length]):
+        raise ValueError('No header padding for explicit EEVEE initializer dependency')
+    command = struct.pack('<6I', 0xC, length, 24, 2, 0, 0) + name
+    command = command.ljust(length, b'\0')
+    result = bytearray(data)
+    result[start:start + length] = command
+    struct.pack_into('<II', result, 16, count + 1, size + length)
+    # Only Mach-O header padding changes; executable sections remain identical.
+    for offset, nbytes, _, _ in sections:
+        if result[offset:offset + nbytes] != data[offset:offset + nbytes]:
+            raise ValueError('Unexpected section modification')
+    return bytes(result)
+
diff --git a/scripts/finalize-companion.py b/scripts/finalize-companion.py
new file mode 100644
index 0000000000000000000000000000000000000000..df5faf8f984c5bdc18d7183f06e3c7c9a5204e5e
--- /dev/null
+++ b/scripts/finalize-companion.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Check the combined source build and establish EV1-before-spoti initialization."""
+import importlib.util
+import os
+from pathlib import Path
+import plistlib
+import shutil
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+spec = importlib.util.spec_from_file_location('companion_macho', Path(__file__).with_name('companion-macho.py'))
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+path = Path(sys.argv[1]).resolve()
+with tempfile.TemporaryDirectory() as temporary, zipfile.ZipFile(path) as original:
+    names = original.namelist()
+    if len(names) != len(set(names)):
+        raise ValueError('Duplicate archive entries')
+    infos = [n for n in names if n.startswith('Payload/') and n.endswith('.app/Info.plist') and n.count('/') == 2]
+    if len(infos) != 1:
+        raise ValueError('Expected one host app')
+    app = infos[0][:-10]
+    info = plistlib.loads(original.read(infos[0]))
+    if info['CFBundleShortVersionString'] != '9.1.78':
+        raise ValueError('Expected Spotify 9.1.78')
+    loads = module.macho(original.read(app + info['CFBundleExecutable']))[2]
+    deps = [name for _, name in loads if name.lower().endswith('/eeveespotify.dylib')]
+    if len(deps) != 1:
+        raise ValueError('Host must load exactly one EEVEE')
+    def one(suffix):
+        found = [n for n in names if n.startswith(app) and n.lower().endswith(suffix.lower())]
+        if len(found) != 1:
+            raise ValueError('Expected exactly one ' + suffix)
+        return found[0]
+    eevee = one('/EeveeSpotify.dylib')
+    glass = one('/spotifyglass.dylib')
+    if not any(name.lower().endswith('/spotifyglass.dylib') for _, name in loads):
+        raise ValueError('Host does not load spoti.pw')
+    if not any('EeveeSwiftProtobuf.framework/' in n for n in names):
+        raise ValueError('Missing EEVEE protobuf framework')
+    if not any('EeveeSpotify.bundle/' in n for n in names):
+        raise ValueError('Missing EEVEE resources')
+    if any('flex' in n.lower() and n.endswith('.dylib') for n in names):
+        raise ValueError('Performance build must not include FLEX')
+    fixed = module.add_dependency(original.read(glass), deps[0])
+    binary = Path(temporary) / 'spotifyglass.dylib'
+    binary.write_bytes(fixed)
+    subprocess.run(['ldid', '-S', str(binary)], check=True)
+    fixed = binary.read_bytes()
+    if (0xC, deps[0]) not in module.macho(fixed)[2]:
+        raise ValueError('Initializer dependency missing after ad-hoc signing')
+    output = Path(temporary) / 'combined.ipa'
+    with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_DEFLATED) as destination:
+        for item in original.infolist():
+            destination.writestr(item, fixed if item.filename == glass else original.read(item))
+    with zipfile.ZipFile(output) as checked:
+        if checked.testzip():
+            raise ValueError('Output archive CRC failure')
+        for name in names:
+            if name != glass and original.getinfo(name).CRC != checked.getinfo(name).CRC:
+                raise ValueError('Unexpected component change: ' + name)
+    staging = path.with_suffix('.verified.ipa')
+    try:
+        shutil.copyfile(output, staging)
+        os.replace(staging, path)
+    finally:
+        staging.unlink(missing_ok=True)
+print('PASS: 9.1.78, one EEVEE + spoti.pw, resources, initializer order, no FLEX, valid archive')
