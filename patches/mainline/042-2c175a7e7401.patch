+// Translate mod-owned presentation text only. Preferences, identifiers and network data stay raw.
+#import <Foundation/Foundation.h>
+FOUNDATION_EXPORT NSString *SGText(NSString *text);
+FOUNDATION_EXPORT NSString *SGTextForLanguage(NSString *text, NSString *language);
diff --git a/tweak/Sources/Core/SGLocalization.m b/tweak/Sources/Core/SGLocalization.m
new file mode 100644
index 0000000000000000000000000000000000000000..f8b5ae61bed90dde2a9f4197f0fc3ae143b8c5d3
--- /dev/null
+++ b/tweak/Sources/Core/SGLocalization.m
@@ -0,0 +1,18 @@
+#import "SGLocalization.h"
+#import <dispatch/dispatch.h>
+
+NSString *SGTextForLanguage(NSString *text, NSString *language) {
+    if (!text || ![language.lowercaseString hasPrefix:@"zh"]) return text;
+    static NSDictionary<NSString *, NSString *> *chinese;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        chinese = @{
+#include "SGChinese.inc"
+        };
+    });
+    return chinese[text] ?: text;
+}
+
+NSString *SGText(NSString *text) {
+    return SGTextForLanguage(text, NSLocale.preferredLanguages.firstObject);
+}
