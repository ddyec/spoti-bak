@@ -0,0 +1,7 @@
+#import <Foundation/Foundation.h>
+
+#define SGKeyLyricsDiagnostics @"spotifyglass.lyricsDiagnostics"
+BOOL SGLyricsDiagnosticsEnabled(void);
+void SGLyricsLog(NSString *format, ...) NS_FORMAT_FUNCTION(1, 2);
